# ==============================================================================
# KONFIGURASI SISTEM PTP-KPU (MONOREPO OFFICE LOCAL ENVIRONMENT)
# ==============================================================================

# 1. DATABASE LOKAL (MySQL di PC Kantor: XAMPP / Laragon / Native / Docker)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/kpu_db

# 2. MODEL AI LOKAL (paket kirana_llm, berjalan di dalam proses backend)
# Model diunduh otomatis saat `pip install -r requirements.txt`.
KIRANA_MODEL_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
KIRANA_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# Opsional: pakai file .gguf lokal (tanpa unduh)
# KIRANA_MODEL_PATH=C:/models/model.gguf
# Opsional: folder penyimpanan model (bawaan: %LOCALAPPDATA%\kirana-llm\models)
# KIRANA_MODEL_DIR=D:/models
# KIRANA_N_CTX=8192
# KIRANA_N_THREADS=0
# KIRANA_N_GPU_LAYERS=0
# KIRANA_MAX_TOKENS=1024

# 3. KEAMANAN & TOKEN JWT
SECRET_KEY=digitalisasi_kpu_provinsi_sulut_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. FRONTEND API BASE URL
VITE_API_BASE_URL=/api/v1
MYSQL_ROOT_PASSWORD=12345
MYSQL_PASSWORD=12345

BOOTSTRAP_ADMIN_NIP=199001012020011001
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=Terserah_apa

# 5. KIRANA di server kantor (Acer AIO, RAM 8 GB)
# Lepaskan memori model (~3,5 GB) setelah N menit tidak dipakai; 0 = tidak pernah.
KIRANA_IDLE_UNLOAD_MINUTES=15

# 6. PENOMORAN SURAT RESMI - biarkan false sampai format nomor & kewenangan disetujui kantor
OFFICIAL_ISSUANCE_ENABLED=false
# Penugasan penomoran/verifikasi resmi (JSON). Kosong = tidak ada yang berwenang.
AUTHORITY_GRANTS=[]

# 7. CLOUDFLARE TUNNEL (opsional, jalankan dengan: docker compose -f docker-compose.production.yml --profile cloudflare up -d)
FRONTEND_PORT=8081
# Token dari Cloudflare Zero Trust -> Networks -> Tunnels -> ptp-kpu (jangan pernah di-commit!)
# CLOUDFLARE_TUNNEL_TOKEN=
